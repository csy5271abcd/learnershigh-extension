%% LearnersHigh Assessment 목표 아키텍처 (향후) — 2026-11-12
%% 굵은 테두리(now) = 현재 구현되어 있는 구성요소 / 점선(future) = 미구현·결정 대기
%% 이 그림은 계획이며, 상자 이름은 현재 코드의 모듈과 다를 수 있다.
flowchart LR
    subgraph CLIENT["Frontend"]
        S["Student"]:::now
        A["Admin"]:::now
    end

    AUTH["실제 인증·인가<br/>(기존 LearnersHigh, API-OD-A01)"]:::future

    subgraph BE["Backend (Spring Boot)"]
        API["REST API<br/>Student / Admin"]:::now
        UP["문서 업로드·Revision<br/>서명 검사 · SHA-256"]:::now
        SCAN["악성 파일 검사"]:::future
        JOB["분석 작업 관리<br/>상태 · 재시도 · (Queue는 필요 시)"]:::future
        REVIEW["Human Review<br/>원문 대조 · fieldPath 확정 · reviewer_auth=VERIFIED"]:::now
        CONF["Confirmed Assessment Data"]:::now
        WF["Student Assessment Workflow<br/>수행평가·노트·결과물·피드백"]:::now
    end

    STORE["운영 File Storage<br/>원본·결과물 보관 · 백업"]:::future

    subgraph AN["분석 서비스 (서비스 간 인증)"]
        PARSE["PDF / HWP / HWPX Parser<br/>(+OCR: 필요성 확인 후)"]:::now
        RULE["Rule-Based Extraction<br/>assembly · task_detail"]:::now
        LLM["Selective LLM Analysis<br/>규칙 실패 구간만 · 마스킹 · 승인"]:::future
        EV["Evidence Validation<br/>Locator · 원문 인용 · 범위"]:::now
    end

    DB[("MySQL")]:::now
    GOLD["Golden Dataset · Benchmark<br/>(사람 판정, 정확도 측정)"]:::future

    S & A --> AUTH --> API
    API --> UP --> SCAN --> STORE
    UP --> JOB --> PARSE --> RULE
    RULE -- "실패·모호 구간" --> LLM --> EV
    RULE --> EV --> JOB
    JOB --> DB
    REVIEW --> CONF --> DB
    API --> REVIEW
    API --> WF --> DB
    WF --> STORE
    CONF --> WF
    GOLD -. "지표" .-> RULE
    GOLD -. "효과 비교" .-> LLM

    classDef now fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef future fill:#f5f5f5,stroke:#888,stroke-dasharray: 5 4,color:#555
