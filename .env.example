# Local development only. 복사해서 .env로 사용한다 (.env는 Git에 커밋하지 않는다).

# docker-compose.yml (MySQL Container)
MYSQL_DATABASE=learnershigh_extension
MYSQL_USER=learnershigh
MYSQL_PASSWORD=learnershigh
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Backend (backend/src/main/resources/application.yml)
DB_URL=jdbc:mysql://localhost:3306/learnershigh_extension
DB_USERNAME=learnershigh
DB_PASSWORD=learnershigh
